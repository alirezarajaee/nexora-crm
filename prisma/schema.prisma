// NEXORA CRM — Prisma schema (SQLite)
// Note: SQLite connector does not support Prisma enums or Json types.
// System-defined states use stable internal string keys (never localized display
// strings), per the localization architecture. JSON-shaped data is stored in
// String columns and parsed at the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  locale       String   @default("fa") // fa | en  (UI language preference)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  memberships Membership[]
  ownedCompanies Company[]  @relation("CompanyOwner")
  ownedContacts  Contact[]  @relation("ContactOwner")
  ownedLeads     Lead[]     @relation("LeadOwner")
  ownedDeals     Deal[]     @relation("DealOwner")
  assignedTasks  Task[]     @relation("TaskAssignee")
  activities     Activity[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 of the cookie token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id   String @id @default(cuid())
  name String
  // Operational settings (independent from UI language):
  currency String @default("USD") // ISO 4217 code
  timezone String @default("Asia/Tehran") // IANA

  // Follow-up Radar configurable thresholds
  radarLeadInactivityDays  Int   @default(7)
  radarDealInactivityDays  Int   @default(7)
  radarStageInactivityDays Int   @default(14)
  radarHighValueThreshold  Float @default(10000)

  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  companies   Company[]
  contacts    Contact[]
  leads       Lead[]
  pipelines   Pipeline[]
  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  tags        Tag[]
  tagRelations TagRelation[]
  notifications Notification[]
  automationRules AutomationRule[]
  automationExecutions AutomationExecution[]
  savedViews  SavedView[]
  customFields CustomField[]
  customFieldValues CustomFieldValue[]
  auditLogs   AuditLog[]
}

model Membership {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        String @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Company {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  website     String?
  industry    String?
  size        String?
  phone       String?
  address     String?
  country     String?
  ownerId     String?
  source      String?
  notes       String?
  archived    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([workspaceId])
  @@index([workspaceId, name])
}

model Contact {
  id             String  @id @default(cuid())
  workspaceId    String
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  companyId      String?
  ownerId        String?
  notes          String?
  archived       Boolean @default(false)
  lastContactedAt DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User?     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([companyId])
}

model Lead {
  id                    String   @id @default(cuid())
  workspaceId           String
  name                  String
  email                 String?
  phone                 String?
  companyName           String?
  jobTitle              String?
  source                String? // WEBSITE REFERRAL SOCIAL CAMPAIGN DIRECT OTHER
  status                String   @default("NEW") // NEW CONTACTED QUALIFIED DISQUALIFIED CONVERTED
  priority              String   @default("MEDIUM") // LOW MEDIUM HIGH
  ownerId               String?
  estimatedValue        Float?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  notes                 String?
  disqualificationReason String?
  archived              Boolean  @default(false)
  convertedContactId    String?
  convertedDealId       String?
  convertedAt           DateTime?
  lastActivityAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks     Task[]
  activities Activity[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, nextFollowUpAt])
}

model Pipeline {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@index([workspaceId])
}

model Stage {
  id          String @id @default(cuid())
  pipelineId  String
  key         String // stable internal key: qualification discovery proposal negotiation won lost ...
  name        String // user-editable display label (not a business identifier)
  order       Int
  probability Int    @default(0) // 0..100
  type        String @default("OPEN") // OPEN | WON | LOST
  createdAt   DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, key])
  @@index([pipelineId])
}

model Deal {
  id               String   @id @default(cuid())
  workspaceId      String
  pipelineId       String
  stageId          String
  title            String
  contactId        String?
  companyId        String?
  value            Float    @default(0)
  currency         String   @default("USD")
  probability      Int      @default(0)
  ownerId          String?
  expectedCloseDate DateTime?
  actualCloseDate  DateTime?
  source           String?
  priority         String   @default("MEDIUM")
  description      String?
  lostReason       String?
  archived         Boolean  @default(false)
  lastActivityAt   DateTime @default(now())
  stageEnteredAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage     Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks     Task[]
  activities Activity[]

  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, pipelineId])
  @@index([workspaceId, ownerId])
}

model Task {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      String   @default("OPEN") // OPEN | DONE
  priority    String   @default("MEDIUM")
  dueAt       DateTime?
  assigneeId  String?
  contactId   String?
  companyId   String?
  dealId      String?
  leadId      String?
  recurrence  String? // NONE | DAILY | WEEKLY | MONTHLY
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueAt])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  type        String // CALL MEETING EMAIL NOTE TASK_EVENT STAGE_CHANGE CONVERSION SYSTEM
  title       String
  content     String?
  userId      String
  contactId   String?
  companyId   String?
  dealId      String?
  leadId      String?
  metadata    String? // JSON string
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
  @@index([workspaceId, leadId])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#8B5CF6")
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  relations TagRelation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TagRelation {
  id          String @id @default(cuid())
  workspaceId String
  tagId       String
  entityType  String // lead | contact | company | deal
  entityId    String
  createdAt   DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([workspaceId, entityType, entityId])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  type        String // ASSIGNMENT TASK_DUE AUTOMATION RADAR SYSTEM
  title       String
  body        String?
  link        String?
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, dedupeKey])
  @@index([workspaceId, userId, readAt])
}

model AutomationRule {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  triggerType String // LEAD_CREATED DEAL_CREATED DEAL_STAGE_CHANGED TASK_OVERDUE DEAL_INACTIVE RECORD_ASSIGNED STATUS_ENTERED
  conditions  String  @default("[]") // JSON: [{field, operator, value}]
  actions     String  @default("[]") // JSON: [{type, params}]
  enabled     Boolean @default(true)
  createdBy   String
  lastRunAt   DateTime?
  runCount    Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions  AutomationExecution[]

  @@index([workspaceId])
}

model AutomationExecution {
  id          String   @id @default(cuid())
  workspaceId String
  ruleId      String
  ruleName    String
  status      String // SUCCESS | FAILED | SKIPPED
  detail      String?
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([ruleId])
}

model SavedView {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  entityType  String
  filters     String @default("{}") // JSON
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, entityType, name])
  @@index([workspaceId])
}

model CustomField {
  id          String  @id @default(cuid())
  workspaceId String
  entityType  String // contact | company | deal | lead
  key         String
  label       String
  type        String // TEXT NUMBER DATE BOOLEAN SELECT MULTI_SELECT URL
  required    Boolean @default(false)
  options     String? // JSON string[] for select types
  defaultValue String?
  order       Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId])
}

model CustomFieldValue {
  id          String  @id @default(cuid())
  workspaceId String
  fieldId     String
  entityType  String
  entityId    String
  value       String?
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([workspaceId, entityId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // CREATE UPDATE ARCHIVE RESTORE DELETE LOGIN CONVERT MERGE IMPORT EXPORT
  entityType  String
  entityId    String?
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
